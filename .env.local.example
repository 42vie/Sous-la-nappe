# --- Firebase Client (exposé côté navigateur) ---
# Source : Firebase Console → Project Settings → General → Your apps → SDK Config

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyChXyIIrZcnFyac5Ja0tvdRVIthBkRjHvQ
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sous-la-nappe.firebaseapp.com
