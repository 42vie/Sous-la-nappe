NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sous-la-nappe.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1057048121171
NEXT_PUBLIC_FIREBASE_APP_ID=1:1057048121171:web:8192a8ba516d38ca1cdba6

# --- Firebase Admin (serveur uniquement — ne PAS préfixer NEXT_PUBLIC_) ---
# Source : Firebase Console → Project Settings → Service Accounts → Générer une clé privée

FIREBASE_ADMIN_PROJECT_ID=sous-la-nappe
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-fbsvc@sous-la-nappe.iam.gserviceaccount.com
# Coller la clé AVEC les guillemets, laisser les \n tels quels
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
